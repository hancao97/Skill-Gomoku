; 听雨弈境 — a local two-player game
config_version=5

[application]
config/name="听雨弈境"
config/version="2.5.2"
config/description="雨落松间，棋起万象。双人同席，五局三胜。"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/textures/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1000
window/size/min_height=680
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.025, 0.06, 0.055, 1)

[audio]
driver/enable_input=false
driver/mix_rate=48000
default_bus_layout="res://default_bus_layout.tres"

[physics]
common/physics_ticks_per_second=60
